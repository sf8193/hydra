flowchart LR
  slack["Slack channel<br/>message events"]

  subgraph daemon["Hydra Discord daemon"]
    direction TB
    lis["Listener<br/>Socket Mode, read-only"]
    handle{"handle(event)<br/>slack-watch.ts"}
    table[("Watch table, owned by the specialist<br/>active, then idle 7d, then expired<br/>delivered ts and owed ts kept")]
    co["Coalesce 4s<br/>sender id and name, text quoted, cap 8 KB"]
    specialist{"deliverToSpecialist<br/>live, connected session?"}
    refill["Refill: respawn into the specialist's thread<br/>from the kickoff<br/>per-specialist lock, backoff"]
    catch["Catch-up<br/>boot after recovery, every reconnect, every 10 min<br/>channel history plus owed and watched threads"]
  end

  subgraph discord["Discord, the specialist's thread"]
    ses["Specialist session"]
    dan(["Operator approves"])
  end

  post["Reply posted to Slack<br/>(outside hydra)"]

  slack --> lis --> handle
  handle -->|"tag, or the bot's own post:<br/>create or refresh"| table
  handle -->|"tag, or reply in a watched thread"| co
  co --> specialist
  specialist -->|"yes"| ses
  specialist -->|"no"| refill --> ses
  co -.->|"failed or orphaned:<br/>ts stays owed"| table
  table -->|"owed and cursors"| catch
  catch -->|"replays missed messages"| handle
  lis -.->|"down for 5+ min:<br/>alert"| ses
  ses -->|"stages drafts"| dan
  dan -->|"explicit go"| post
