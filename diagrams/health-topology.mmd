%% Hydra runtime health topology — what runs, how it connects, what monitors it.
%% Use alongside /debug-hydra-issues for diagnostic orientation.

flowchart TD
    subgraph platform["Platform"]
        discord["Discord API"]
        slack["Slack API"]
    end

    subgraph gateway["Gateway Process"]
        dg["discord-gateway.ts"]
        sg["slack-gateway.ts"]
        gwh["gateway-health.ts<br/>shard lifecycle + reconnect"]
    end

    subgraph daemon["Daemon (long-lived, one per platform)"]
        router["router.ts<br/>command intercept + routing"]
        transport["bridge-transport.ts<br/>session delivery"]
        lifecycle["session-lifecycle.ts<br/>spawn / resume / kill"]
        server["bridge-server.ts<br/>socket accept + death detect"]
    end

    subgraph health["Health Monitors"]
        poll["daemon.ts session poll<br/>5min: crash detect, orphan<br/>detect (90s grace), context alerts"]
        obs["observability.ts<br/>60s vitals, death reports,<br/>session ID correlation"]
        mbc["main-bridge-cycle.ts<br/>flap tracking, uptime"]
    end

    subgraph sessions["Sessions (one tmux pane + bridge each)"]
        byte["Byte (main)<br/>the primary session"]
        spawn1["Spawn<br/>Claude Code / Codex"]
        spawn2["Spawn<br/>Claude Code / Codex"]
    end

    subgraph bridges["Bridges (MCP relay, one per session)"]
        b0["bridge.ts → byte"]
        b1["bridge.ts → spawn"]
        b2["bridge.ts → spawn"]
    end

    subgraph state["State (disk)"]
        sj["sessions.json"]
        logs["spawn-logs/{name}-{uuid}.log"]
        dlog["~/hydra-{platform}-daemon.log"]
        alive["daemon.alive<br/>heartbeat (connectivity-aware)"]
    end

    subgraph external["External"]
        watchdog["launchd watchdog<br/>120s: tmux + heartbeat check"]
        mcp_logs["~/Library/Caches/claude-cli-nodejs/<br/>mcp-logs-*/*.jsonl<br/>(bridge stderr — the gold)"]
    end

    discord --> dg
    slack --> sg
    dg --> router
    sg --> router
    dg --> gwh
    sg --> gwh

    router --> transport
    router --> preg
    transport --> server

    server -- "unix socket" --> b0
    server -- "unix socket" --> b1
    server -- "unix socket" --> b2

    b0 -- "MCP stdio" --> byte
    b1 -- "MCP stdio" --> spawn1
    b2 -- "MCP stdio" --> spawn2

    poll --> server
    poll --> lifecycle
    obs -.-> dlog
    mbc --> server
    watchdog -.-> alive

    lifecycle -.-> sj
    lifecycle -.-> logs
    server -.-> sj
    server -.-> dlog
    b0 -.-> mcp_logs
    b1 -.-> mcp_logs

    classDef fail stroke:#e74c3c,stroke-width:2px,stroke-dasharray:5 5
    classDef health stroke:#27ae60,stroke-width:2px

    class poll,obs,mbc,watchdog health
    class dg,sg,b0,b1,b2 fail
