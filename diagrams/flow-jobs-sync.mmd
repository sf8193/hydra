%% hydra jobs sync (cli/jobs.ts jobsSync, syncLaunchd; connectors/clock/jobs-clock.ts requestSync).
flowchart TD
  S["hydra jobs sync PLATFORM"] --> P{"jobs.toml exists and parses?"}
  P -->|no| E1["exit 1; the daemon is never asked"]
  P -->|yes| SK{"daemon.sock answers jobs-sync (15s)?"}
  SK -->|"no socket, or refused"| M1["print: daemon not running; it loads this on start"]
  SK -->|"timeout or error"| M2["print: it loads jobs.toml on its next tick"]
  SK -->|yes| RQ["requestSync: before = the config the last sync made live;<br/>lastGoodConfig = syncedConfig = text; one tick now"]
  RQ --> DF["reply {before, after, hydraEntry}<br/>print added / changed (effective values, toml keys) / removed"]
  M1 & M2 & DF --> LIVE{"the state dir is the platform's live dir?"}
  LIVE -->|no| NOTE["print: launchd entries only for the live dir"]
  LIVE -->|yes| B{"stableBun: PATH bun not under /Cellar/,<br/>else a known link"}
  B -->|none| E2["print the error; exit 1"]
  B --> REG["each launchd job: plist (stable bun; the daemon's hydra.ts, else the one the plist already runs;<br/>calendar; a fixed PATH; log). Identical: left loaded.<br/>Else bootout, write, bootstrap; a failure removes the plist and exits 1"]
  REG --> UN["each com.hydra.job.PLATFORM.* no longer wanted: bootout + remove<br/>(com.hydra.watchdog.* never matches)"]
  UN --> LG["each bun.cron.hydra-job-PLATFORM-*: Bun.cron.remove"]
  LG --> PJ["printJobs: target, runner and where it came from; notes;<br/>launchd notes (owed results, entries to migrate); TCC warnings"]
  NOTE --> PJ
  E2 --> PJ
