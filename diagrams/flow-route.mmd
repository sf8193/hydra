%% routing/route.ts: which specialist hears a message, and whether its sender may reach it. Pure and content-blind:
%% it reads who sent a message and where, never what it says. Every connector asks it; `hydra route` prints its trace.
flowchart TD
  in(["message: from (an address), at (every name the place goes by,<br/>most specific first), addressed (DM or tag), bound (the conversation's specialist)"])
  who["identify: the person whose ids hold the address<br/>roles = theirs + people + anyone; a stranger holds only anyone<br/>operator = that person is hydra.toml's operator"]
  b{"bound?"}
  bd{"that specialist still declared?<br/>(was = renames followed)"}
  ad{"addressed, or a place here<br/>has listen = all?"}
  ign(["ignored: not for hydra"])
  r{"first [[rules]] entry whose at is a name here<br/>and whose from is the sender or a role they hold"}
  l{"a specialist that listens on a name here<br/>(the id before the #name)"}
  od{"the operator, in a DM?"}
  main["main"]
  unr(["unrouted → 🚫 on a mention or DM"])
  allow{"allow: the operator always;<br/>main only the operator;<br/>else a role in the specialist's allow"}
  ref(["refused → 🚫 on a mention or DM<br/>nothing bound, nothing owed"])
  del(["deliver to it; a new conversation is bound to it"])
  in --> who --> b
  b -->|yes| bd
  bd -->|yes| allow
  bd -->|"no: routed anew"| r
  b -->|no| ad
  ad -->|no| ign
  ad -->|yes| r
  r -->|match| allow
  r -->|none| l
  l -->|match| allow
  l -->|none| od
  od -->|yes| main --> allow
  od -->|no| unr
  allow -->|no| ref
  allow -->|yes| del
