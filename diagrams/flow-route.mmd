%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#ffffff","primaryBorderColor":"#6b7280","primaryTextColor":"#1f2937","lineColor":"#374151","clusterBkg":"#ffffff","clusterBorder":"#d1d5db"},"flowchart":{"wrappingWidth":420,"useMaxWidth":false}}}%%
%% Which target hears a message, and may its sender reach it? route(), routing/route.ts:201. Pure: config and message in, a Fate out.
%% route() first asks which app is the owning app (route.ts:211-218): drawn in flow-route-owning-app. A Fate is a decision, not an action:
%% the Slack connector acts on it, and may still drop a "deliver" (flow-slack-accept). Every box's source: diagrams/flow-route.sources.md.
flowchart TD
  in(["a message this app is the owning app of<br/>flow-route-owning-app"])
  who["<b>Person, roles</b><br/>who sent it; a stranger holds only anyone"]
  g1{"1. <b>Binding</b>?"}
  g2{"2. addressed, or a place here<br/>has messages = all?"}
  n2["addressed: a DM or group DM, a tag,<br/>or an open conversation with no target yet"]
  g3{"3. the first <b>Rule</b><br/>that matches?"}
  n3["a rule matches when each key it sets fits:<br/>place: a name of this place<br/>app: this app<br/>person: the sender, or a role they hold<br/>and this app <b>serves</b> its target"]
  g3b{"4. a tag in a channel thread,<br/>and this app names a <b>router</b>?"}
  g4{"5. the <b>Operator</b>,<br/>in the bot's DM?"}
  main["main"]
  g5{"6. <b>Reach</b>: may the<br/>sender reach it?"}
  n5["first, this app must serve it; then:<br/>the operator: every target<br/>main: the operator only<br/>a session's own thread: anyone<br/>a specialist, a router too: a role in its reachable_by"]
  del(["deliver<br/>after 3, 4 or 5, bind the conversation to it"])
  ref(["refused"])
  unr(["unrouted"])
  ign(["ignored: not for hydra"])

  in --> who --> g1
  g1 -->|"bound, and it holds"| g5
  g1 -->|"none, or this app<br/>no longer serves it"| g2
  g1 -->|"bound, but hydra.toml<br/>no longer declares it"| g3
  g2 -.- n2
  g2 -->|no| ign
  g2 -->|yes| g3
  g3 -.- n3
  g3 -->|a rule| g5
  g3 -->|none| g3b
  g3b -->|yes| g5
  g3b -->|no| g4
  g4 -->|yes| main --> g5
  g4 -->|no| unr
  g5 -.- n5
  g5 -->|yes| del
  g5 -->|no| ref

  classDef gate fill:#fff7ed,stroke:#f97316,color:#1f2937
  classDef stop fill:#fef2f2,stroke:#ef4444,color:#1f2937
  classDef done fill:#ecfdf5,stroke:#10b981,color:#1f2937
  classDef note fill:#f9fafb,stroke:#d1d5db,color:#4b5563
  class g1,g2,g3,g3b,g4,g5 gate
  class ref,unr stop
  class del done
  class n2,n3,n5 note
