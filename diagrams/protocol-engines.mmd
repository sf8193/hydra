%% Protocol Engine — declarative DSL + generic runner
%% Single protocol system after v1 removal (PR #148).
%% router.ts dispatches review/build/spike through commands/protocol.ts → protocol-loader.ts → runner.

flowchart TD
    subgraph dispatch["Dispatch — router.ts → commands/protocol.ts"]
        cmd["commands/protocol.ts<br/><b>handleProtocolIntercept</b><br/><i>review, build, spike</i><br/>_v2 suffix stripped transparently"]
        loader["protocol-loader.ts<br/>dynamic import + validation<br/><i>path-traversal guard</i>"]
        cmd --> loader
    end

    subgraph definitions["Protocol Definitions — protocols/"]
        p_review["protocols/review.ts<br/><b>review</b><br/>critic_turn → owner_turn<br/>→ cleanup → complete"]
        p_build["protocols/build.ts<br/><b>build</b><br/>implementing → reviewing<br/>→ closing → complete"]
        p_spike["protocols/spike.ts<br/><b>spike</b><br/>exploring → reporting → complete"]
    end

    subgraph engine["Protocol Engine"]
        dsl["protocol-dsl.ts<br/>protocol() builder →<br/>frozen typed Protocol"]
        types["protocol-types.ts<br/>RunState, BehaviorContext,<br/>CompletionEvent, RoundAdvanceEvent"]
        runner["protocol-runner.ts<br/>generic runner:<br/>fireTransition · advancePhase<br/>spawn from seeds · protocolEvents"]
        sm["state-machine.ts<br/>createStateMachine()"]
        mods["modifiers.ts<br/>+security (+s)"]
    end

    subgraph infra["Shared Infrastructure"]
        registry["protocol-registry.ts<br/>mutual exclusion +<br/>reconnect/disconnect hooks"]
        nudge["advance-nudge.ts<br/>missing-advance liveness check"]
        autoresume["auto-resume.ts<br/>MAX_RESUME_ATTEMPTS=5"]
        tools["bridge-tools.ts<br/>dynamic tool scoping<br/>(advance per phase)"]
    end

    subgraph consumers["Event Consumers"]
        factory["factory.ts<br/>protocolEvents.onComplete<br/>protocolEvents.onRoundAdvance<br/><i>build→review cycle</i>"]
    end

    loader --> p_review
    loader --> p_build
    loader --> p_spike

    p_review --> dsl
    p_build --> dsl
    p_spike --> dsl

    dsl --> sm
    dsl --> runner
    types -.-> runner
    runner --> mods

    runner --> registry
    registry --> nudge
    registry --> autoresume
    registry --> tools

    runner -.-> factory

    classDef dispatchstyle fill:#fce4ec,stroke:#c62828
    classDef defstyle fill:#e3f2fd,stroke:#1565c0
    classDef engstyle fill:#e8f5e9,stroke:#2e7d32
    classDef infrastyle fill:#f3e5f5,stroke:#6a1b9a
    classDef consumestyle fill:#fff3e0,stroke:#e65100

    class cmd,loader dispatchstyle
    class p_review,p_build,p_spike defstyle
    class dsl,types,runner,sm,mods engstyle
    class registry,nudge,autoresume,tools infrastyle
    class factory consumestyle
