%% Recovery Cascade
%% Three tiers of session recovery, plus death detection trigger.

flowchart TD
    subgraph triggers["Entry Points"]
        resume["resume<br/><i>thread-scoped</i>"]
        respawn["respawn<br/><i>thread-scoped</i>"]
        recover["recover<br/><i>global batch</i>"]
    end

    subgraph primitives["Shared Primitives<br/><i>session-lifecycle.ts</i>"]
        tryResume["<b>tryResume</b><br/>drives T1 + T2"]
        tryRespawn["<b>tryRespawn</b><br/>drives T3"]
        waitForBridge["<b>waitForBridge</b><br/>validates health after recovery"]
    end

    subgraph cascade["Recovery Tiers"]
        t1["<b>T1: --resume</b><br/>full context restoration"]
        t2["<b>T2: --resume --fork-session</b><br/>transcript copy"]
        t3["<b>T3: tryRespawn</b><br/>fresh session reads thread"]
    end

    subgraph outcomes["Outcomes"]
        full["full history"]
        transcript["transcript"]
        thread["thread context"]
        fail["<b>report failure</b>"]
    end

    subgraph death["Death Detection"]
        detect["bridge disconnect<br/>+ tmux dead"]
        check["checkSessionDeath()<br/><i>bridge-server.ts</i>"]
        crashed["name crashed → resume"]
    end

    resume --> tryResume
    recover --> tryResume
    respawn --> tryRespawn

    tryResume --> t1
    tryResume --> t2

    t1 -- ok --> waitForBridge
    t1 -- fail --> t2
    t2 -- ok --> waitForBridge
    t2 -- fail --> tryRespawn

    tryRespawn --> t3
    t3 -- ok --> waitForBridge
    t3 -- fail --> fail

    waitForBridge -- healthy --> full
    waitForBridge -- healthy --> transcript
    waitForBridge -- healthy --> thread

    detect --> check --> crashed
    crashed --> tryResume
