%% Protocol Robustness — shared properties across v1 and v2 engines
%% Phase lists, loops, mutual exclusion, and disconnect handling.
%% For v1/v2 engine architecture, see protocol-engines.mmd.

flowchart LR
    subgraph review_phases["Review Phases"]
        r_ct["critic_turn"] --> r_ot["owner_turn"]
        r_ot -- "owner_posted<br/>(loop)" --> r_ct
        r_ot -- "final_round" --> r_pp["post_pass<br/><i>(v1 only)</i>"]
        r_pp --> r_cl["cleanup"]
        r_ot -- "final_round<br/>(v2)" --> r_cl
        r_cl --> r_done["complete"]
        r_ct -- "fallback<br/>(critic death or silence)" --> r_fb["subagent_review<br/><i>owner runs subagent review</i>"]
        r_ot -- "fallback<br/>(critic death)" --> r_fb
        r_start(["review +subagent"]) -- "direct<br/>(no critic spawned)" --> r_fb
        r_fb --> r_done
    end

    subgraph build_phases["Build Phases"]

        b_impl["implementing"] --> b_rev["reviewing"]
        b_rev -- "critic_feedback<br/>(loop)" --> b_impl
        b_rev -- "approved" --> b_close["closing"]
        b_close --> b_done["complete"]
    end

    subgraph design_phases["Design Phases"]

        d_spawn["spawning"] --> d_q["questioning"]
        d_q --> d_a["answering"]
        d_a --> d_ind["independent"]
        d_ind --> d_syn["synthesis"]
        d_syn --> d_ref["refinement"]
        d_ref -- "loop" --> d_syn
        d_ref -. "direct phase mutation<br/>(bypasses state machine)" .-> d_audit["audit"]
        d_audit --> d_brief["brief"]
        d_brief --> d_done["complete"]
    end

    subgraph spike_phases["Spike Phases"]

        s_exp["exploring"] -- "checkpoint<br/>(self-loop)" --> s_exp
        s_exp -- "wrap_up" --> s_rep["reporting"]
        s_rep --> s_done["complete"]
    end

    mutex["isThreadOccupied() — symmetric:<br/>any active protocol blocks any other.<br/>No hierarchy — first in wins."]

    subgraph disconnect["Disconnect Handling"]

        disc["disconnect"] --> resume_check["auto-resume<br/>decision (3s)"]
        resume_check -- retryable --> auto_resume["auto-resume<br/>(up to 5 attempts)"]
        resume_check -- not retryable --> grace["grace timer"]
        grace -- reconnect --> continue["continue"]
        grace -- timeout --> exhausted{"canFallbackOnDeath?<br/>(non-owner death +<br/>on.fallback + onFallback +<br/>not +no-fallback)"}
        auto_resume -- "attempt fails" --> exhausted
        idle["phase window / total backstop<br/>elapses on a non-owner actor"] --> exhausted
        exhausted -- "yes (review critic)" --> fbr["subagent_review<br/>see flow-review-fallback"]
        exhausted -- "no" --> cancel["cancel"]
    end

    subgraph roles["Grace Periods (v1 roles / v2 per-spec)"]

        r1["Critic: <b>30s</b>"]
        r2["Owner: <b>2min</b>"]
        r3["Persona: <b>0s</b>"]
        r4["Singleton: <b>30s</b>"]
        r5["Spike explorer/guide: <b>2min</b><br/><i>(v2 spec-defined)</i>"]
    end
