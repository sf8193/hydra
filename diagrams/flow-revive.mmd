%% Who is home, and putting a session back into a thread. Drawn from the code (reconciled by a cold review of the
%% stack, then corrected for its findings). (a) occupancy() decides; (b) every revive goes through reviveThread()
%% under one lock per target; (c) `deliver --thread T --revive` asks for it; (d) every target resolves to a session and
%% lands through deliverToSession (targets.ts).
flowchart TD
  subgraph A["(a) occupancy(info): session-reachability.ts"]
    A0{"record?"} -- no --> AN[none]
    A0 -- yes --> A1{"transport.has?<br/>(Codex: = isAlive)"}
    A1 -- yes --> AR[reachable]
    A1 -- no --> A2{"adapter.isAlive?<br/>Claude/omp: tmux · Codex: socket or reconnecting"}
    A2 -- no --> AD[dead]
    A2 -- yes --> A3{"deadAt set, or waitMs > 90s<br/>waitMs = now − max(createdAt, daemonStart)"}
    A3 -- yes --> AO[orphaned]
    A3 -- no --> AS[starting]
  end

  subgraph B["(b) back into an existing thread"]
    CH["chat resume / respawn"] --> HELD{"threadLockHeld?"}
    HELD -- yes --> BUSYMSG["'already in progress'"]
    HELD -- no --> TL["withThreadLock(targetKeyForThread)"]
    TL --> CO{"occupancy"}
    CO -- "reachable / starting" --> REF["refuse: running / still starting"]
    CO -- orphaned --> RTO["reviveThread(orphan)"]
    CO -- "dead / none" --> MD["resume: markDead"]
    RTO --> RT
    MD --> RT
    RC["recover / boot candidates<br/>(!occupied · boot: deadAt ∧ no tmux)"] --> DEDUP[dedupForRecovery] --> RL["recoverLocked: withThreadLock"]
    RL --> RO{"thread's record occupied?"}
    RO -- yes --> RF["failed: already live as X"]
    RO -- no --> WT["recoverOne: reattach / defer / skip worktree"] --> RT
    SP["deliver / spawn --specialist"] --> NL["withTargetLock(name)"] --> SO{"occupant in specialist.threadId?<br/>(re-read under lock)"}
    SO -- "orphaned (deliver)" --> E4s[exit 4]
    SO -- "occupied" --> HOME["deliver to it · spawn: exit 3"]
    SO -- vacant --> HOLD{"same name occupied elsewhere?"}
    HOLD -- yes --> E3h[exit 3]
    HOLD -- no --> SB{"back-off active?<br/>(not for spawn --specialist)"}
    SB -- yes --> BOs["exit 6: not retrying until …<br/>(the platform is not asked)"]
    SB -- no --> TE{"threadExists (gone = 10003 only)"}
    TE -- "gone, no channel" --> ERR[error]
    TE -- "exists" --> RT
    TE -- "gone + channel" --> RTN["reviveThread(newThreadIn)"]
    HO["handOff"] --> HL["withThreadLock"] --> HC{"record still this one?"}
    HC -- no --> HX["throw: already handing off"]
    HC -- yes --> HS["handoffSpawnOpts: carryOver minus read_only and predecessor<br/>→ kill → spawn(handedOffFrom)<br/>→ restoreWatches → repointChildren"]

    RT["reviveThread<br/>chat and recover pass the target's key, ignoring its wait"] --> BG{"backoffKey active and not ignored?"}
    RTN --> BG
    BG -- yes --> BO["fail: not retrying until …"]
    BG -- no --> WS["snapshot the dead record's PR watches"]
    WS --> ORQ{"orphan to tear down?"}
    ORQ -- yes --> ORPH["kill it (worktree kept), markDead<br/>its record is still in hand"]
    ORQ -- no --> SNAP
    ORPH --> SNAP["resolve entry/dead · carryOver unless respawnOnly (to every tier, tryResume too)<br/>worktree if on disk · reserve branch base<br/>(never the name being claimed)"]
    SNAP --> NT{"newThreadIn?"}
    NT -- yes --> NEWT["spawn in channel from kickoff, worktree kept,<br/>told its old thread is gone"]
    NT -- no --> T1{"ids and not respawnOnly?"}
    T1 -- yes --> R1["tier 1: tryResume · omp / codex: home reserved?"]
    R1 -- "reserved" --> BUSY[busy: exit 5]
    R1 -- fail --> R2["tier 2: fork"] -- fail --> R3
    T1 -- no --> R3["tier 3: tryRespawn(respawnTopic)"]
    R1 -- ok --> OK
    R2 -- ok --> OK
    R3 -- ok --> OK
    NEWT -- ok --> OK["repointChildren · restoreWatches · clearBackoff<br/>(a claimed name retires dead same-named records: doSpawnSession)"]
    R3 -- "null or throw" --> FAIL["restore dead record + watches if thread unclaimed<br/>recordFailure(key) → exit 6"]
    NEWT -- throw --> FAIL
    OK -- specialist --> REP{"re-pointed meanwhile?"}
    REP -- yes --> E3r[exit 3, left running]
    REP -- no --> SET["setSpecialist(threadId) · pushToolSurface"]
  end

  subgraph C["(c) deliver --thread T --revive: cli-handler.ts"]
    D0{"--thread set, no --session?"} -- no --> DV[error]
    D0 -- yes --> DS{"a specialist's thread?"}
    DS -- yes --> SPD["deliver to the specialist (b): its name, kickoff, back-off"]
    DS -- no --> DL["withThreadLock(T)"] --> DO{"occupancy of T's record"}
    DO -- orphaned --> D4[exit 4]
    DO -- "starting / reachable" --> DQ["revived: false"]
    DO -- "dead / none" --> DB{"back-off on T?"}
    DB -- yes --> D6b["exit 6: not retrying until …<br/>(the platform is not asked)"]
    DB -- no --> DE{"threadExists"}
    DE -- "gone (10003)" --> D3b["exit 3: gone"]
    DE -- yes --> DR["reviveThread(thread or a stub for an unknown one,<br/>backoffKey = T)"]
    DR -- "busy" --> D5[exit 5]
    DR -- "fail" --> D6[exit 6]
    DR -- ok --> DQ2["revived: true"]
    DQ --> DD["queue = true → deliver: queued or delivered"]
    DQ2 --> DD
  end

  subgraph D["(d) deliverToTarget(t): targets.ts"]
    T0["size cap → permanent exit 3 · idempotency: in flight → 5, landed → ok duplicate, else reserve"] --> TK{"target"}
    TK -- "to" --> TR{"resolveTo"}
    TR -- main --> TM["main: bridge or --queue (exit 4); never revived"]
    TR -- "declared specialist" --> TS["ensureSpecialist(name) (b) → orphaned: exit 4"]
    TR -- "all digits" --> TT["toThread (c)"]
    TR -- "anything else" --> T8["exit 8: no such specialist"]
    TK -- "spawn" --> TF["a fresh session from the recipe (idle → reaped when quiet)"]
    TK -- "perThread + key" --> TP["ensureSpecialist(perThreadName(key), recipe), never stored"]
    TS & TT & TF & TP --> LS["deliverToSession: dead 3 · orphaned 4 · booting 5 (unless queued)<br/>reachable but stuck on a dialog → 5 'stuck: kind'<br/>→ adapter.deliver"]
    LS --> TO["landed: key kept · else key released"]
    ST["send_to_thread(target = a specialist)"] --> TS
    SET["specialist set / rm"] --> SL["withTargetLock(name)"] --> SG{"set --thread elsewhere while the old thread is occupied?"}
    SG -- yes --> G3["G: exit 3 'is live in T1; hydra kill X first'"]
    SG -- no --> SW["write the record"]
  end
