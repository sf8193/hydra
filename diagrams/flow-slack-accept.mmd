%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#ffffff","primaryBorderColor":"#6b7280","primaryTextColor":"#1f2937","lineColor":"#374151","clusterBkg":"#ffffff","clusterBorder":"#d1d5db"},"flowchart":{"wrappingWidth":420,"useMaxWidth":false}}}%%
%% Which Slack messages does an app take up and hand to routing?
%% SlackWatcher.handle and classify, connectors/slack/watch.ts:734 and :756.
%% Before: flow-slack-hear, flow-slack-catchup. Next: flow-route-owner, flow-route, flow-slack-fate. Every box's source: diagrams/flow-slack-accept.sources.md.
flowchart TD
  in(["a Slack message, live or caught up,<br/>through the <b>App</b> that heard it"])
  g1{"1. the app connected,<br/>and the ts valid?"}
  cur["its <b>Cursor</b> moves, whatever follows:<br/>in a channel a rule names, now;<br/>in the bot's DM, once owed;<br/>never while catch-up holds it"]
  g2{"2. a message<br/>to take up?"}
  n2["not taken up:<br/>an edit, a delete, a join<br/>another hydra app's bot<br/>another bot, unless the place has bots = true<br/>one already in flight"]
  names["its <b>Place</b> names"]
  nn["a channel: slack:id, slack:#name<br/>an app's bot DM: slack:app-dm:app<br/>a DM with a person: slack:person-dm:person<br/>a group DM: slack:id, slack:group-dm:id"]
  g3{"3. the place named,<br/>or the <b>Conversation</b> open?"}
  n3["named: slack:app-dm:app, a [places] entry,<br/>or a rule's place for a target this app serves"]
  g4{"4. the bot's own?"}
  own(["opens a <b>Conversation</b> for whoever<br/>a rule sends this place to; nothing owed"])
  g5{"5. delivered before?"}
  take["just before: a tag in a thread a session listens in<br/>hands it to whoever a rule sends it to,<br/>and the session is told"]
  g6{"6. this app the <b>Owner</b>?<br/>flow-route-owner"}
  routed(["routed: flow-route,<br/>then flow-slack-fate"])
  ign1(["ignored"])
  ign2(["ignored"])
  ign3(["ignored"])
  ign4(["ignored"])
  ign5(["ignored"])
  tfull(["dropped: table-full"])

  in --> g1
  g1 -.- cur
  g1 -->|no| ign1
  g1 -->|yes| g2
  g2 -.- n2
  g2 -->|no| ign2
  g2 -->|yes| names --> g3
  names -.- nn
  g3 -.- n3
  g3 -->|"yes; or no, in any other case"| g4
  g3 -->|"no, and a DM with a person or a group DM,<br/>or untagged where the app has the operator's token"| ign3
  g4 -->|"yes: a top-level post"| own
  own -->|"no room"| tfull
  g4 -->|"yes: a reply, in a DM,<br/>seen before, or no rule here"| ign4
  g4 -->|no| g5
  g5 -->|yes| ign4
  g5 -->|no| g6
  g6 -.- take
  g6 -->|"no"| ign5
  g6 -->|"yes, or a DM"| routed

  classDef gate fill:#fff7ed,stroke:#f97316,color:#1f2937
  classDef stop fill:#fef2f2,stroke:#ef4444,color:#1f2937
  classDef wait fill:#f3f4f6,stroke:#9ca3af,color:#1f2937
  classDef done fill:#ecfdf5,stroke:#10b981,color:#1f2937
  classDef note fill:#f9fafb,stroke:#d1d5db,color:#4b5563
  class g1,g2,g3,g4,g5,g6 gate
  class tfull stop
  class routed done
  class cur,n2,nn,n3,take note
