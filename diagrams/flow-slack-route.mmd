%% A Slack message's path from event to delivery, derived from the code, with every refusal and drop.
%% REFUSED / UNROUTED: logged once, counted (by sender / in all), removed from owed, never alerted; a mention or a DM gets 🚫.
%% Routing itself (binding → rules → listens → the operator's DM to main, then allow) is routing/route.ts: see flow-route.mmd.
%% DROP: logged, counted by kind, alerted once per episode (an hour from its start), per app, kind and target. Guard drops are not alerted.
%% One connection per Slack app (connectors/slack/connections.ts): each has its own listener, catch-up, cursors and alert episodes; a message and its reply go through the same app.
flowchart TD
  subgraph src["sources"]
    live["live event, through the app that heard it<br/>(one listener per app) listener.ts onMessage"]
    trig["catch-up triggers, for each app on its own: boot, reconnect,<br/>every 10 min deep, retry 60s, queued"]
    c0["0. list bot DMs (im:read; a failure logs once an hour)<br/>senders whose DM would be delivered; a new DM is read back 24h,<br/>and gets its cursor at once only when found empty"]
    c1["1. owedHints: every conversation, wherever its binding<br/>DM top-level → history from just before"]
    c2["3. history: routed channels, then known DMs<br/>least recently read first, in what the budget leaves<br/>after the threads' calls; empty DM → cursor now<br/>a DM not reached stays held: live events cannot move its cursor"]
    c3["2. deep: list every watched thread<br/>(their calls are kept back)"]
    hold["on connect, per app: auth.test (bot ids, workspace),<br/>scope check against what THIS app does,<br/>conversations.list (#names → ids), then before the socket opens<br/>hold every channel hydra.toml names and known DM"]
    c4["4. replies per thread<br/>(a reply never moves the channel cursor)"]
    cbud{"budget spent?"}
    gap[["DROP catch-up-gap: a channel past 5 pages<br/>moves to its newest read; the rest is surfaced"]]
    cinc(["incomplete: cursors held,<br/>catchingUp stays on, retry 60s"])
    cok(["complete: cursors advance"])
    hold --> trig
    trig --> c0 --> c1 --> c3 --> c2 --> c4 --> cbud
    c2 -.->|">5 pages"| gap
    cbud -->|spent| cinc
    cbud -->|ok| cok
  end
  live --> h0
  c2 --> h0
  c4 --> h0

  subgraph handle["connectors/slack/watch.ts handle / classify"]
    h0{"connected?<br/>(view = hydra.toml + what Slack taught)"}
    h1{"valid ts, plain subtype, not in flight,<br/>not another bot (unless place bots = true)?"}
    cown{"bot's own?"}
    csub["own top-level: opens, bound to the listener there,<br/>ts marked delivered"]
    cseen{"already delivered?"}
    ow{"several apps heard it?<br/>one owns it: a tag outranks the bound app,<br/>then the opener, default_app, default, first<br/>the others stand down"}
    rt{"route(): at = [slack:C…, slack:#name] or [slack:dm]<br/>addressed = DM, tag, or open conversation<br/>bound = the conversation's specialist"}
    react["🚫 reaction, if a mention or a DM"]
    cap{"new conversation, not a DM: tag cap"}
    ctab{"table room?"}
    bind["bind: specialist = route's winner<br/>(new, legacy store, or its specialist is gone)"]
    owe["owed += ts, persisted"]
    co["coalesce window → flushKey<br/>inflight, per-thread run"]
    cur["cursor advances in channels hydra.toml names,<br/>unless a pass holds it; DM only when delivered"]
  end
  ign(["ignored"])
  ref[["REFUSED / UNROUTED"]]
  h0 -->|no| ign
  h0 --> h1
  h1 -->|no| ign
  h1 --> cown
  cown -->|"own reply, own DM"| ign
  cown -->|own top-level| csub
  csub -.->|full| dfull[["DROP table-full"]]
  cown -->|person| cseen
  cseen -->|yes| ign
  cseen -->|no| ow
  ow -->|"not the owner"| ign
  ow -->|"owner, or the only app"| rt
  rt -->|"ignored: not addressed,<br/>no listen = all"| ign
  rt -->|"refused (allow) or unrouted"| ref
  ref --> react
  rt -->|deliver| cap
  cap -->|over| dcap[["DROP tag-cap"]]
  cap -->|"ok, or already open"| ctab
  ctab -->|full| dfull
  ctab -->|ok| bind --> owe
  owe -.->|">200"| dofull[["DROP owed-full"]]
  owe --> co
  h0 -.-> cur

  subgraph deliver["deliverBatches, once per burst"]
    r0{"binding declared in hydra.toml?<br/>(was = renames followed)"}
    unr(["no: stays owed;<br/>its replay is routed anew"])
    r1{"allow re-judged, current config"}
    nm["who: person, roles, operator from hydra.toml;<br/>a stranger's Slack name without mentions"]
    g{"[guard], per message, ≤4<br/>never for the operator"}
    gopen["other exit, timeout, >4 KB,<br/>no start, throw: logged"]
    g10[["DROP guard, settled, not alerted"]]
    g75{"75: older than owed_max?"}
    g75o(["no: stays owed"])
    grp["group by target, order kept<br/>a redirect whose allow refuses the sender,<br/>or names no specialist (alerted) → the binding"]
    fl["files ≤2 at once: place files, link, ≤20 MB,<br/>connected → .part 0600 → rename,<br/>one download per file however many ask<br/>else listed with why"]
    snd["global send chain → packItems ≤8 KB<br/>envelope: place, conversation, link; per item person, roles, operator<br/>deliverToTarget(to, key incl. target)"]
    ok["ok or exit 2 → place ack reaction → settle<br/>delivered never trimmed past the oldest owed, nor the parent"]
    rep(["specialist replies: posted through the app that heard<br/>the conversation, never another<br/>(a post with no message uses speaks_as)"])
    big[["DROP too-large, settled"]]
    e8["exit 8 (no session record):<br/>alert, stays owed"]
    err(["other error: stays owed"])
  end
  co --> r0
  r0 -->|no| unr
  r0 -->|yes| r1
  r1 -->|no| ref
  r1 -->|yes| nm --> g
  g -->|"none, operator, or 0"| grp
  g -->|"0 + {to}"| grp
  g --> gopen --> grp
  g -->|10| g10
  g -->|75| g75
  g75 -->|no| g75o
  g75 -->|yes| exp
  g75o -.->|cut| dofull
  grp --> fl --> snd
  snd --> ok
  ok -.-> rep
  snd -->|permanent| big
  snd --> e8
  snd --> err
  err -.->|cut| dofull

  sweep["hourly sweep"] --> exp[["DROP expired: owed >24h,<br/>or held by a 75 past owed_max"]]
  sweep --> idle["idle, nothing owed: watch removed<br/>quiet DM cursors pruned<br/>slack-files older than 7d removed"]
  unr -.-> exp
  e8 -.-> exp
  err -.-> exp
  g75o -.->|owedHints| c1
  unr -.->|owedHints| c1
  e8 -.->|owedHints| c1
  err -.->|owedHints| c1

  al["alert(text, to, app)<br/>to: the specialist it concerns;<br/>else the specialists that app serves and that hear Slack;<br/>else main (also an undeclared app, or no thread yet)"]
  al --> th{"where does it post?"}
  th -->|"a specialist"| post(["its thread"])
  th -->|main| mainch(["main's channel"])
  th -->|"neither yet"| se(["stderr"])
  la["per app, own episode: listener down ≥5 min, back up,<br/>catch-up stale ≥25 min, permanent Slack error,<br/>missed live events, a declared scope missing (once per episode,<br/>kept across restarts), names unreadable, tokens missing (app skipped)"] --> al
  dfull -.-> al
  dcap -.-> al
  dofull -.-> al
  big -.-> al
  exp -.-> al
  e8 -.-> al
