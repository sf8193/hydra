%% Fork Command — Flow Through the Layers
%% Each layer does one thing and passes to the next.
%% Swap the gateway implementation and the flow is identical.

sequenceDiagram
    participant User
    participant gateway as {platform}-<br/>gateway.ts
    participant router as router.ts
    participant thread as commands/<br/>thread.ts
    participant lifecycle as session-<br/>lifecycle.ts
    participant sessions as sessions.ts<br/>SessionRegistry
    participant transport as bridge-<br/>transport.ts
    participant server as bridge-<br/>server.ts
    participant cc as New Claude<br/>Code session

    User->>gateway: types "fork" in session thread
    gateway->>router: InboundMessage (normalized)
    router->>router: regex match → "fork"<br/>resolve thread → session
    router->>thread: handleForkIntercept(msg)
    thread-->>User: react(🍴)
    thread->>sessions: read parent claudeSessionId

    alt claudeSessionId is null
        thread->>thread: discoverClaudeSessionId<br/>from ~/.claude/sessions/<pid>.json
    end

    alt claudeSessionId available
        thread->>lifecycle: doSpawnSession(opts: {forkFrom})
        lifecycle->>gateway: createThread (→ Chat API)
        lifecycle->>lifecycle: spawn tmux with<br/>--resume --fork-session
        lifecycle->>sessions: register new session
        lifecycle->>transport: sendOrQueue(notification)
        Note right of transport: queued until bridge connects
        cc->>server: socket connect + "register"
        server->>transport: register bridge connection
        transport->>cc: flush queued notification
        cc-->>User: reply(greeting in new thread)
    else no claudeSessionId (bridge never registered)
        thread->>lifecycle: doSpawnSession(opts: {existingThreadId})<br/>respawn fallback — reads parent thread
        Note over thread: fork degrades to respawn:<br/>fresh session reads thread history<br/>instead of inheriting conversation
        lifecycle->>sessions: register new session
        cc-->>User: reply(context from thread history)
    end
