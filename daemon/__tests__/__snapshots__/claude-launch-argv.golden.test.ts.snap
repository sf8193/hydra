exports[`fresh, resume and fork launches are pinned byte for byte: tools-and-disallowed 1`] = `"new-session -d -s g-t ulimit -n 65536 2>/dev/null; _hydra_write_exit() { _HYDRA_EXIT_CODE=$?; _HYDRA_EXIT_TS=$(date +%s); { echo "exit_code=$_HYDRA_EXIT_CODE"; echo "wall_clock=\${SECONDS}s"; echo "exit_ts=$_HYDRA_EXIT_TS"; echo "session_id=g-s"; echo "tmux_name=g-t"; if [ $_HYDRA_EXIT_CODE -gt 128 ]; then echo "signal=$(( $_HYDRA_EXIT_CODE - 128 ))"; fi; } > '<state>/spawn-logs/exit-g-t-g-s.log'; }; trap _hydra_write_exit EXIT && cd '/work' && export HYDRA_SESSION_ID='g-s' && export HYDRA_SESSION_NAME='g-t' && export HYDRA_THREAD_ID='' && export HYDRA_SESSION_TYPE='' && export DAEMON_SOCK='<state>/daemon.sock' && export CLAUDE_CONFIG_DIR='<state>/claude' && export CHAT_PLATFORM='discord' && export CLAUDE_CODE_PLUGIN_DIRS='<state>/mods/hydra' && unset HYDRA_ROLE && claude --session-id '<uuid>' --model 'claude-opus-4-1' --channels 'plugin:discord@claude-plugins-official' --dangerously-skip-permissions 'it'\\''s a prompt' --disallowedTools 'Bash' --tools 'Read,Grep' --debug-file '<state>/spawn-logs/debug-g-t-g-s.log' 2>>'<state>/spawn-logs/stderr-g-t-g-s.log'"`;
