// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`argv fresh, resume and fork are pinned byte for byte: fresh 1`] = `"new-session -d -s sc-t ulimit -n 65536 2>/dev/null; _hydra_write_exit() { _HYDRA_EXIT_CODE=$?; _HYDRA_EXIT_TS=$(date +%s); { echo "exit_code=$_HYDRA_EXIT_CODE"; echo "wall_clock=\${SECONDS}s"; echo "exit_ts=$_HYDRA_EXIT_TS"; echo "session_id=<uuid>"; echo "tmux_name=sc-t"; if [ $_HYDRA_EXIT_CODE -gt 128 ]; then echo "signal=$(( $_HYDRA_EXIT_CODE - 128 ))"; fi; } > '<state>/spawn-logs/exit-sc-t-<uuid>.log'; }; trap _hydra_write_exit EXIT && cd '/work/ops' && export HYDRA_SESSION_ID='<uuid>' && export HYDRA_SESSION_NAME='sc-t' && export HYDRA_THREAD_ID='' && export HYDRA_SESSION_TYPE='scoped' && export DAEMON_SOCK='<state>/daemon.sock' && export CLAUDE_CONFIG_DIR='<state>/claude' && export CHAT_PLATFORM='discord' && export CLAUDE_CODE_PLUGIN_DIRS='<state>/mods/hydra' && export ENABLE_CLAUDEAI_MCP_SERVERS=false && unset HYDRA_ROLE && claude --session-id '<uuid>' --model 'claude-opus-4-1' 'it'\\''s a prompt' --channels 'plugin:discord@claude-plugins-official' --restricted --tools 'Read,Grep,Glob' --settings '<state>/scoped/sc-t-<uuid>.settings.json' --mcp-config '<state>/scoped/sc-t-<uuid>.mcp.json' --permission-mode dontAsk --debug-file '<state>/spawn-logs/debug-sc-t-<uuid>.log' 2>>'<state>/spawn-logs/stderr-sc-t-<uuid>.log'"`;

exports[`argv fresh, resume and fork are pinned byte for byte: resume 1`] = `"new-session -d -s sc-t ulimit -n 65536 2>/dev/null; _hydra_write_exit() { _HYDRA_EXIT_CODE=$?; _HYDRA_EXIT_TS=$(date +%s); { echo "exit_code=$_HYDRA_EXIT_CODE"; echo "wall_clock=\${SECONDS}s"; echo "exit_ts=$_HYDRA_EXIT_TS"; echo "session_id=<uuid>"; echo "tmux_name=sc-t"; if [ $_HYDRA_EXIT_CODE -gt 128 ]; then echo "signal=$(( $_HYDRA_EXIT_CODE - 128 ))"; fi; } > '<state>/spawn-logs/exit-sc-t-<uuid>.log'; }; trap _hydra_write_exit EXIT && cd '/work/ops' && export HYDRA_SESSION_ID='<uuid>' && export HYDRA_SESSION_NAME='sc-t' && export HYDRA_THREAD_ID='' && export HYDRA_SESSION_TYPE='scoped' && export DAEMON_SOCK='<state>/daemon.sock' && export CLAUDE_CONFIG_DIR='<state>/claude' && export CHAT_PLATFORM='discord' && export CLAUDE_CODE_PLUGIN_DIRS='<state>/mods/hydra' && export ENABLE_CLAUDEAI_MCP_SERVERS=false && unset HYDRA_ROLE && claude --resume 'C-old' --model 'claude-opus-4-1' --channels 'plugin:discord@claude-plugins-official' --restricted --tools 'Read,Grep,Glob' --settings '<state>/scoped/sc-t-<uuid>.settings.json' --mcp-config '<state>/scoped/sc-t-<uuid>.mcp.json' --permission-mode dontAsk --debug-file '<state>/spawn-logs/debug-sc-t-<uuid>.log' 2>>'<state>/spawn-logs/stderr-sc-t-<uuid>.log'"`;

exports[`argv fresh, resume and fork are pinned byte for byte: fork 1`] = `"new-session -d -s sc-t ulimit -n 65536 2>/dev/null; _hydra_write_exit() { _HYDRA_EXIT_CODE=$?; _HYDRA_EXIT_TS=$(date +%s); { echo "exit_code=$_HYDRA_EXIT_CODE"; echo "wall_clock=\${SECONDS}s"; echo "exit_ts=$_HYDRA_EXIT_TS"; echo "session_id=<uuid>"; echo "tmux_name=sc-t"; if [ $_HYDRA_EXIT_CODE -gt 128 ]; then echo "signal=$(( $_HYDRA_EXIT_CODE - 128 ))"; fi; } > '<state>/spawn-logs/exit-sc-t-<uuid>.log'; }; trap _hydra_write_exit EXIT && cd '/work/ops' && export HYDRA_SESSION_ID='<uuid>' && export HYDRA_SESSION_NAME='sc-t' && export HYDRA_THREAD_ID='' && export HYDRA_SESSION_TYPE='scoped' && export HYDRA_FORKED_FROM_CLAUDE_SESSION_ID='C-parent' && export DAEMON_SOCK='<state>/daemon.sock' && export CLAUDE_CONFIG_DIR='<state>/claude' && export CHAT_PLATFORM='discord' && export CLAUDE_CODE_PLUGIN_DIRS='<state>/mods/hydra' && export ENABLE_CLAUDEAI_MCP_SERVERS=false && unset HYDRA_ROLE && claude --resume 'C-parent' --fork-session --model 'claude-opus-4-1' 'it'\\''s a prompt' --channels 'plugin:discord@claude-plugins-official' --restricted --tools 'Read,Grep,Glob' --settings '<state>/scoped/sc-t-<uuid>.settings.json' --mcp-config '<state>/scoped/sc-t-<uuid>.mcp.json' --permission-mode dontAsk --debug-file '<state>/spawn-logs/debug-sc-t-<uuid>.log' 2>>'<state>/spawn-logs/stderr-sc-t-<uuid>.log'"`;
