{
  "config": {
    "operator": "op",
    "connectors": {},
    "gateways": {},
    "slackApps": {
      "default": {
        "id": "default",
        "botTokenEnv": "CONNECTOR_SLACK_BOT_TOKEN",
        "displayName": "hydra",
        "description": "Answers the Slack threads it is tagged in, and its DMs, using Claude."
      },
      "sales": {
        "id": "sales",
        "botTokenEnv": "SALES_SLACK_BOT_TOKEN",
        "displayName": "sales",
        "description": "Answers the Slack threads it is tagged in, and its DMs, using Claude."
      }
    },
    "people": {
      "op": {
        "id": "op",
        "addresses": [
          "slack:U0OP"
        ],
        "roles": [],
        "name": "op"
      }
    },
    "specialists": {
      "ops": {
        "id": "ops",
        "workdir": "/home/op/ops",
        "listens": [
          "slack:dm"
        ],
        "reachableBy": [
          "people"
        ],
        "sessions": "shared",
        "maxSessions": 20,
        "renamedFrom": [],
        "restricted": false
      },
      "deals": {
        "id": "deals",
        "workdir": "/home/op/deals",
        "listens": [
          "slack:#deals"
        ],
        "reachableBy": [
          "people"
        ],
        "pinnedTo": [
          "sales"
        ],
        "speaksAs": "sales",
        "sessions": "shared",
        "maxSessions": 20,
        "renamedFrom": [],
        "restricted": false
      },
      "crm": {
        "id": "crm",
        "workdir": "/home/op/crm",
        "listens": [],
        "reachableBy": [
          "people"
        ],
        "sessions": "per-conversation",
        "maxSessions": 20,
        "renamedFrom": [],
        "kickoff": "Hello.",
        "restricted": false
      }
    },
    "places": {},
    "schedules": {
      "nightly": {
        "id": "nightly",
        "cron": "0 3 * * *",
        "message": "Nightly.",
        "runner": "launchd",
        "target": "ops"
      },
      "to-main": {
        "id": "to-main",
        "cron": "0 9 * * 1",
        "message": "Weekly.",
        "runner": "launchd",
        "target": "main"
      },
      "sensor": {
        "id": "sensor",
        "cron": "*/5 * * * *",
        "message": "",
        "runner": "launchd",
        "check": "true"
      }
    },
    "rules": [
      {
        "target": "crm",
        "place": "slack:#sales-help"
      },
      {
        "target": "deals",
        "app": "sales"
      },
      {
        "target": "main",
        "place": "slack:#oncall",
        "person": "op"
      }
    ]
  },
  "warnings": [
    {
      "path": "connectors.slack",
      "message": "rename the table [connectors.slack] to [slack.apps.default]; it still loads and will be removed"
    },
    {
      "path": "specialists.ops",
      "message": "one shared session hears everyone's DMs (reachable_by = [\"people\"]), so one person's DM is remembered in another's; use sessions = \"per-conversation\" or reachable_by = []"
    },
    {
      "path": "specialists.ops",
      "message": "ops is unpinned, and app sales is pinned by deals, so ops no longer hears sales on slack:dm"
    },
    {
      "path": "specialists.crm",
      "message": "conversations past max_sessions (20) will wait until a session is ended by hand; set idle"
    }
  ]
}
