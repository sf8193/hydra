{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@types/bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "daemon/**/*.ts", "infra/**/*.ts", "engines/**/*.ts", "sessions/**/*.ts", "app/**/*.ts", "cli/**/*.ts", "shared/**/*.ts", "config/**/*.ts", "routing/**/*.ts", "connectors/**/*.ts", "specialists/**/*.ts", "protocols/**/*.ts", "gateways/*.ts"],
  "exclude": ["node_modules"]
}
