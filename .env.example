# Hydra — chat ↔ Claude Code bridge.
# Copy the vars you need into your daemon's state-dir .env:
#   ~/.claude/channels/<platform>/.env        (override the dir with HYDRA_STATE_DIR)
# Real shell env always wins over this file.

# Which platform this daemon serves: slack | discord
CHAT_PLATFORM=slack

# ── Slack (Socket Mode) ── create an app at https://api.slack.com/apps
# Bot User OAuth Token — OAuth & Permissions               (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with the connections:write scope —
#   Basic Information → App-Level Tokens                   (starts with xapp-)
SLACK_APP_TOKEN=xapp-...

# ── Discord (set CHAT_PLATFORM=discord instead) ──
# DISCORD_BOT_TOKEN=...

# ── Required ──
# SPAWN_CWD=~/your-work-dir        # cwd for spawned sub-sessions
# CLAUDE_CONFIG_DIR=~/.claude      # must contain the bridge plugin (see docs/slack.md)

# ── Optional (have sensible defaults) ──
# HYDRA_MODEL=claude-opus-4-6[1m]                # default model for byte + spawns; per-spawn override: hydra spawn --model <id>
# HYDRA_STATE_DIR=~/.claude/channels/discord     # state dir (socket, sessions, access)
# DEFAULT_SESSION_CHANNEL=                       # Discord: channel for spawned threads from DMs
# TMUX_SESSION=discord-daemon                    # tmux session name for the daemon
# HYDRA_LOG=~/hydra-daemon.log                   # daemon + restart log file
# HYDRA_AUTH=auto                                # auto (token/native keychain) | keychain (copy keychain cred into config dir)
# HYDRA_SOCKET_TIMEOUT=15000                     # ms to wait for the daemon socket on up/restart

# ── Voice dictation ── transcribe inbound audio attachments to text so you can
# dictate prompts. ON by default on the daemon side: when a transcription sidecar
# is reachable it's used; when it isn't, audio messages pass through untranscribed.
# One-time setup for the model: ./transcribe-server/setup.sh — after that the
# sidecar starts and stays up with the daemon (hydra up / start-daemon.sh /
# watchdog), no extra config. Full guide: transcribe-server/README.md
# HYDRA_TRANSCRIBE_AUTOSTART=1                        # force autostart on (loud if unconfigured) or 0 to never autostart;
#                                                     # unset = auto (start when set up; mock is never auto-started)
# HYDRA_TRANSCRIBE_BACKEND=parakeet                  # parakeet (macOS default) | canary (CUDA) | mock
# PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3  # default (2.4GB, best accuracy);
#                                                    # pin ...tdt_ctc-110m (437MB) on slow/flaky networks
# HYDRA_TRANSCRIBE_ENABLED=0                          # set to 0/false to disable entirely
# HYDRA_TRANSCRIBE_URL=http://127.0.0.1:8123/transcribe
# HYDRA_TRANSCRIBE_TIMEOUT_MS=60000                  # per-request timeout
# HYDRA_TRANSCRIBE_MAX_BYTES=26214400                # skip audio larger than 25MB

# ── Raindrop observability (opt-in, off by default) — see README.md
# RAINDROP_MODE=dryrun
# RAINDROP_WRITE_KEY=""
# RAINDROP_USER_ID=
# RAINDROP_OMIT_REPO=1
